<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.wmata-dashboard.pull-and-derive</string>

    <!--
        Run bin/pull-and-derive-nightly.sh (which wraps
        bin/pull-and-derive.sh) once daily at 06:30 local time (Eastern,
        on the user's machine) — after the retired
        com.wmata-dashboard.daily-batch's old 03:00 slot (this job now
        supersedes it — see docs/DEPLOYMENT.md §12).

        06:30 ET, not 03:30 (review finding, PR #259): the fire time must
        be after BOTH agencies' owl service has actually ended in their
        own timezone, plus S3 upload lag — not just after WMATA's day
        rolls over in Eastern. SFMTA's owl service runs to ~03:00
        Pacific = 06:00 Eastern, the later of the two agencies' cutoffs
        and so the binding constraint. run_daily_batch.py only re-derives
        a service_date with zero `runs` rows, so firing before that
        (e.g. the original 03:30 ET = 00:30 PT) would derive Muni's
        service date while owl trips were still in flight, permanently
        lose them (no zero-`runs` re-derive on a later run), and then
        have the trip_update_state cleanup step prune the still-relevant
        state out from under them.

        launchd's StartCalendarInterval fires a missed run on the next
        wake if the laptop was asleep at 06:30 (unlike a cron-style fixed
        interval, it doesn't just skip the missed occurrence) — so a
        sleeping laptop yields "fresh within the hour of opening it,"
        rather than "fresh only on nights the laptop happened to be
        awake." launchd uses the system's local timezone here — no UTC
        conversion needed.
    -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <!--
        RunAtLoad=false: don't fire immediately when `launchctl load`
        runs. Surprising and noisy for a multi-hour-capable job;
        install-time validation happens by running the wrapper manually
        (`bin/pull-and-derive-nightly.sh`) first.
    -->
    <key>RunAtLoad</key>
    <false/>

    <key>WorkingDirectory</key>
    <string>/Users/wlovotti/repos/wmata-dashboard</string>

    <!--
        launchd jobs do not inherit the user's shell PATH. The wrapper
        script (and bin/pull-and-derive.sh underneath it) shells out to
        `uv`, `aws`, `curl`, and BSD `date` by bare name, so PATH has to
        include their Homebrew location explicitly — matching the PATH
        an interactive terminal session on this machine actually has.
    -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/wlovotti/repos/wmata-dashboard/bin/pull-and-derive-nightly.sh</string>
    </array>

    <!--
        The wrapper writes nothing of its own to a separate file — this
        IS the log. logs/ must exist before launchd execs the job (it
        opens this path before running ProgramArguments and fails the
        spawn silently if the directory is missing) — `mkdir -p logs` is
        part of the install runbook (docs/DEPLOYMENT.md §12) and the
        wrapper script also creates it defensively on every run.
    -->
    <key>StandardOutPath</key>
    <string>/Users/wlovotti/repos/wmata-dashboard/logs/pull-and-derive.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/wlovotti/repos/wmata-dashboard/logs/pull-and-derive.log</string>
</dict>
</plist>
